{
  "name": "bookmyscreen-backend",
  "version": "1.0.0",
  "description": "Movie Booking System",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:theaters": "ts-node src/scripts/seed-theaters.ts",
    "seed:movies": "ts-node src/scripts/seed-movies.ts",
    "seed:shows": "ts-node src/scripts/seed-shows.ts",
    "typecheck": "tsc --noEmit",
    "test:locks": "ts-node src/tests/booking-flow.test.ts",
    "make-admin": "ts-node src/scripts/make-admin.ts",
    "seed:all:prod": "node dist/scripts/seed-theaters.js && node dist/scripts/seed-movies.js && node dist/scripts/seed-shows.js",
    "seed:shows:prod": "node dist/scripts/seed-shows.js",
    "make-admin:prod": "node dist/scripts/make-admin.js"
  },
  "author": "ProgrammingWithAmrit",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mailgen": "^2.0.29",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.1",
    "nodemailer": "^7.0.4",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^6.4.17",
    "mingo": "^7.2.5",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}