# ---------- Server ----------
PORT=9000
NODE_ENV=development
# Comma separated list of allowed browser origins (CORS + Socket.IO)
FRONTEND_URL=http://localhost:5173

# ---------- Database ----------
# Local Mongo / Docker:  mongodb://localhost:27017/bookmyscreen
# MongoDB Atlas (free):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookmyscreen
MONGO_CONNECTION_STRING=mongodb://localhost:27017/bookmyscreen

# ---------- Redis (seat locking) ----------
# Local / Docker:        redis://localhost:6379
# Upstash (free, TLS):   rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379
SEAT_LOCK_TTL_SECONDS=300
MAX_SEATS_PER_BOOKING=10

# ---------- Auth ----------
# generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
HASH_SECRET=
# the tutorial demo uses 1m / 1d - defaults below are friendlier for real use
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ACCESS_COOKIE_MAX_AGE_MS=900000
REFRESH_COOKIE_MAX_AGE_MS=604800000
# Cookies: same-origin / localhost -> lax + not secure. Frontend & API on different HTTPS domains -> none + true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------- Email (OTP) ----------
# Gmail address + a Google "App Password" (Google Account > Security > 2-Step Verification > App passwords)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ---------- Payments: Razorpay TEST mode (free, no real money, no KYC) ----------
# Dashboard > switch to "Test Mode" > Account & Settings > API Keys > Generate Test Key
# Leave these two EMPTY to use the built-in mock gateway for local development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you set up the optional webhook (Dashboard > Webhooks). Any random string you choose.
RAZORPAY_WEBHOOK_SECRET=
TAX_RATE=0.05

# ---------- Shows ----------
SHOW_TIMEZONE=Asia/Kolkata
# set to false only if you want to book shows that already started (local testing)
ENFORCE_SHOW_TIME=true
